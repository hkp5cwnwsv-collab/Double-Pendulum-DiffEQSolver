   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"pts", "=", 
       RowBox[{
        RowBox[{"Reap", "[", 
         RowBox[{
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"eq", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"t1", "[", "0", "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{"t2", "[", "0", "]"}], "==", "0"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"t1", "'"}], "[", "0", "]"}], "==", "i"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"t2", "'"}], "[", "0", "]"}], "==", "i"}]}], "}"}], 
              ",", 
              RowBox[{"WhenEvent", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"t2", "[", "t", "]"}], "==", "0"}], ",", 
                RowBox[{"Sow", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"t1", "[", "t", "]"}], ",", 
                   RowBox[{
                    RowBox[{"t1", "'"}], "[", "t", "]"}]}], "}"}], "]"}]}], 
               "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t1", ",", "t2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], ";"}], 
         "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"hi", "=", 
       RowBox[{"Graphics", "[", 
        RowBox[{
         RowBox[{"Point", "[", "pts", "]"}], ",", 
         RowBox[{"Axes", "->", "True"}], ",", 
         RowBox[{"PlotRange", "->", "Automatic"}]}], "]"}]}], ";", 
      RowBox[{"Export", "[", 
       RowBox[{
        RowBox[{"\"\</Users/krosniak1/Desktop/PrettyPlot2/PlotNumber\>\"", "<>", 
         RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.png\>\""}], ",", 
        "hi"}], "]"}], ";"}], "}"}], ",", 
    RowBox[{"{", 
